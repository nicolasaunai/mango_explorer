{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": { "$spec/*": ["../src/mango_explorer/spec/*"], "$golden/*": ["../golden/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
